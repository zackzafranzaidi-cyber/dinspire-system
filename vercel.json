{
  "rewrites": [
    {
      "source": "/css/(.*)",
      "has": [{ "type": "host", "value": "customer.dinspirebarbershop.com" }],
      "destination": "/customer/css/$1"
    },
    {
      "source": "/js/(.*)",
      "has": [{ "type": "host", "value": "customer.dinspirebarbershop.com" }],
      "destination": "/customer/js/$1"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "customer.dinspirebarbershop.com" }],
      "destination": "/customer/"
    },
    {
      "source": "/manifest.json",
      "has": [{ "type": "host", "value": "customer.dinspirebarbershop.com" }],
      "destination": "/customer/manifest_customer.json"
    },
    {
      "source": "/sw.js",
      "has": [{ "type": "host", "value": "customer.dinspirebarbershop.com" }],
      "destination": "/customer/sw.js"
    },
